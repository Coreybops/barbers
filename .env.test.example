# Test Environment Configuration
# Copy this file to .env.test for local testing

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/barber_booking_test"
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/barber_booking_test"

# JWT Secrets (use different values in production)
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_REFRESH_SECRET="test-jwt-refresh-secret-key-for-testing-only"

# Environment
NODE_ENV="test"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Test Email Configuration (optional)
EMAIL_FROM="test@barberbooking.com"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# File Upload (optional for tests)
UPLOAD_DIR="./test-uploads"
MAX_FILE_SIZE=5242880

# Rate Limiting (disabled in tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# External Services (use test endpoints)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
GOOGLE_MAPS_API_KEY="test_api_key"

# Notification Services (disabled in tests)
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# Logging
LOG_LEVEL="error"