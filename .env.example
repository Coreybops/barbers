# Root environment variables for the monorepo

# Development
NODE_ENV="development"

# Database (shared across services)
DATABASE_URL="postgresql://username:password@localhost:5432/barber_booking_db"

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000

# JWT Secrets (CHANGE THESE IN PRODUCTION - Use strong random strings of at least 32 characters)
JWT_SECRET="CHANGE-THIS-TO-A-STRONG-RANDOM-STRING-OF-AT-LEAST-32-CHARACTERS"
JWT_REFRESH_SECRET="CHANGE-THIS-TO-ANOTHER-STRONG-RANDOM-STRING-OF-AT-LEAST-32-CHARACTERS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
AUTH_RATE_LIMIT_MAX=5

# CORS Security
FRONTEND_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5000"

# File Upload Security
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=1048576
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="combined"

# Email Configuration (Optional)
EMAIL_FROM="noreply@barberbooking.com"
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# External Services
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
GOOGLE_MAPS_API_KEY=""

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# Performance
DATABASE_CONNECTION_LIMIT=10
CACHE_TTL=300