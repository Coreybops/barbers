# Analytics (Optional)
VITE_GA_TRACKING_ID="G-XXXXXXXXXX"

# Feature Flags
VITE_ENABLE_PAYMENTS="false"
VITE_ENABLE_NOTIFICATIONS="true"
VITE_ENABLE_REVIEWS="true"